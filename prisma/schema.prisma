// CREServices — consultation booking + admin data model.
// Dev uses SQLite (zero setup). Point DATABASE_URL at Postgres for production;
// the schema below is compatible with both.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum ConsultationStatus {
  NEW
  CONTACTED
  SCHEDULED
  COMPLETED
  CANCELLED
}

model Consultation {
  id               String             @id @default(cuid())
  fullName         String
  email            String
  phone            String
  serviceInterest  String
  notes            String?

  // Removed from the public form by the Milestone 1 revision (§10.1).
  // Deliberately kept as OPTIONAL columns rather than dropped: existing
  // consultation rows still hold this data and dropping the columns would
  // destroy it. Nothing writes them any more.
  companyName      String?
  address          String?
  preferredDate    String?
  preferredTime    String?
  status           ConsultationStatus @default(NEW)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([status])
  @@index([createdAt])
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}
