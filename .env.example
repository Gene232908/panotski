# Database (SQLite by default for local dev; swap to Postgres for production)
DATABASE_URL="file:./dev.db"

# Admin dashboard auth
ADMIN_EMAIL="admin@cresvcs.com"
ADMIN_PASSWORD="change-me-before-launch"
SESSION_SECRET="replace-with-a-long-random-string"

# Consultation notification email (optional — booking still saves to the
# database without it, notifications are just skipped if unset)
RESEND_API_KEY=""
NOTIFICATION_FROM_EMAIL="notifications@cresvcs.com"
NOTIFICATION_TO_EMAIL="cres.solidum@cresvcs.com"
